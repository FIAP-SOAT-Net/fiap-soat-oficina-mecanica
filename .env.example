# ============================================
# EXEMPLO DE VARIÁVEIS DE AMBIENTE
# Smart Mechanical Workshop API
# ============================================

# ===== DATABASE =====
ConnectionStrings__DefaultConnection=Server=mysql;Port=3306;Database=smartworkshop;Uid=root;Pwd=password;

# ===== APPLICATION =====
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080
BaseUrl=http://localhost:8080

# ===== JWT =====
Jwt__Key=your_secret_key_here_minimum_32_characters_long
Jwt__Issuer=smartworkshop.com

# ===== EMAIL =====
Email__SmtpHost=smtp.example.com
Email__SmtpPort=587
Email__SenderAddress=noreply@smartworkshop.com
Email__SenderName=Oficina Smart
Email__SmtpUsername=user@example.com
Email__SmtpPassword=password
Email__EnableSsl=true

# ===== NEW RELIC =====
# Habilita/desabilita custom events (default: false)
NewRelic__Enabled=false
NewRelic__AppName=smart-mechanical-workshop-api

# License Key - OBRIGATÓRIO se NewRelic__Enabled=true
# Obtenha em: https://one.newrelic.com/admin-portal/api-keys/home
# ⚠️ NUNCA commite este arquivo com valores reais!
NEW_RELIC_LICENSE_KEY=your_license_key_here
NEW_RELIC_APP_NAME=smart-mechanical-workshop-api

# ===== NOTAS DE SEGURANÇA =====
# 1. Copie este arquivo para .env: cp .env.example .env
# 2. Preencha os valores reais no arquivo .env
# 3. O arquivo .env está no .gitignore e NÃO será commitado
# 4. No CI/CD (GitHub Actions), use Secrets e Variables
# 5. No Kubernetes, use ConfigMaps e Secrets
